# 本机预览可直接使用。正式部署时，将以下三个值一起改为自己的域名。
GYM_DOMAIN=gym.example.com
RP_ID=localhost
ORIGIN=http://localhost:8080
WEB_PORT=8080
DEFAULT_LANG=zh
RP_NAME=我的健身记录
# 首次在正式 HTTPS 域名创建自己的账号，完成前用服务器/代理访问控制限制访问。
# 创建后把 INVITE_ONLY 改为 1，再开放日常访问。详见 README.zh-CN.md。
FIRST_USER_ADMIN=1
INVITE_ONLY=1
ALLOW_GUEST=0
PASSWORD_LOGIN=0
